<?xml version="1.0" encoding="UTF-8"?>
<!--
    Seguridad declarativa de MediConecta.

    Este archivo no configura JAX-RS (eso lo hace AplicacionRest con
    @ApplicationPath): existe unicamente para declarar QUE esta protegido y
    QUIEN puede entrar.

    Desde la Entrega 2 la identidad llega en un JWT (cabecera
    "Authorization: Bearer ..."). No hay <login-config>: el mecanismo de
    autenticacion es seguridad.MecanismoAutenticacionJwt, un
    HttpAuthenticationMechanism de Jakarta Security que el contenedor descubre
    solo e invoca en cada peticion. Lo que cada rol puede hacer se sigue
    declarando con @RolesAllowed sobre los metodos de negocio.
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>MediConecta</display-name>

    <!-- 1) Health checks publicos (/api/salud y /api/salud/vivo). El patron mas
         especifico gana sobre /api/*, asi que quedan accesibles sin
         autenticar: los consultan Docker y el pipeline de CI, que no tienen
         usuario. No tienen auth-constraint a proposito. -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Salud</web-resource-name>
            <url-pattern>/api/salud</url-pattern>
            <url-pattern>/api/salud/*</url-pattern>
        </web-resource-collection>
    </security-constraint>

    <!-- 2) Inicio de sesion: tiene que ser publico, es donde se obtiene el
         token. Igual que /api/salud, el patron mas especifico gana. -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Inicio de sesion</web-resource-name>
            <url-pattern>/api/auth/*</url-pattern>
        </web-resource-collection>
    </security-constraint>

    <!-- 3) Toda la API necesita un usuario autenticado. Que puede hacer cada rol
         NO se decide aca sino con @RolesAllowed sobre los metodos de negocio:
         esta restriccion solo garantiza que haya una identidad. -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>API de MediConecta</web-resource-name>
            <url-pattern>/api/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>PACIENTE</role-name>
            <role-name>RECEPCION</role-name>
            <role-name>MEDICO</role-name>
            <role-name>ADMIN</role-name>
        </auth-constraint>
    </security-constraint>

    <!-- Las pantallas de /app/* ya no se protegen aca: son HTML estatico sin
         datos. Con JWT el navegador no manda el token al navegar entre paginas
         (solo lo manda fetch, en la cabecera Authorization), asi que una
         restriccion sobre /app/* dejaria afuera a todos. Los datos estan en
         /api/*, que si esta protegido; cada pantalla consulta /api/sesion al
         cargar y, sin token valido, vuelve a login.html. -->

    <security-role>
        <description>Paciente: reserva y consulta sus propios turnos.</description>
        <role-name>PACIENTE</role-name>
    </security-role>
    <security-role>
        <description>Recepcion: administra la agenda y el padron de pacientes.</description>
        <role-name>RECEPCION</role-name>
    </security-role>
    <security-role>
        <description>Medico: ve la agenda, cancela turnos y define su disponibilidad.</description>
        <role-name>MEDICO</role-name>
    </security-role>
    <security-role>
        <description>Administrador: ademas da de alta profesionales.</description>
        <role-name>ADMIN</role-name>
    </security-role>

    <session-config>
        <session-timeout>30</session-timeout>
        <!-- La cookie de sesion solo la usa el asistente @Stateful. HttpOnly:
             ningun script la puede leer. SameSite=Strict lo agrega
             WEB-INF/undertow-handlers.conf con el handler samesite-cookie de
             WildFly: el atributo no existe en el esquema 6.0 de web.xml y
             Undertow ignora SessionCookieConfig.setAttribute("SameSite"). Ese
             archivo no admite comentarios, por eso la explicacion esta aca. -->
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>
