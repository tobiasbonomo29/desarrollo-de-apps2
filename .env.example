# =============================================================================
#  MediConecta - variables de entorno para Docker Compose
# =============================================================================
#  Copiar a .env (que NO se versiona) y completar:
#
#      cp .env.example .env
#
#  Para generar valores aleatorios:   openssl rand -base64 48
# =============================================================================

# Contrasena del usuario "mediconecta" de PostgreSQL (la usan la base, las
# migraciones y la aplicacion).
MEDICONECTA_DB_CLAVE=

# Secreto con el que se firman los JWT. Al menos 32 caracteres.
MEDICONECTA_JWT_SECRETO=

# Contrasena de los usuarios de demostracion (paciente, recepcion, medico,
# admin). Si se deja vacia, la aplicacion NO crea esos usuarios. Minimo 8
# caracteres. La de la defensa es Demo.2026.
MEDICONECTA_DEMO_CLAVE=

# Opcional: clave de la API de Groq para el asistente de IA de la reserva.
MEDICONECTA_IA_CLAVE=

# Opcional: puertos en la maquina local.
# MEDICONECTA_PUERTO=8080
# MEDICONECTA_DB_PUERTO=5434
