<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mediconecta</groupId>
    <artifactId>mediconecta-turnos</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>

    <name>MediConecta - Componente Gestion de Turnos</name>
    <description>TP Integrador de Desarrollo de Aplicaciones II</description>

    <properties>
        <!-- UTF-8 en todo el proyecto: es obligatorio para que el mensaje
             "Hola desde el contenedor" con signos de apertura salga bien. -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <!-- Versiones de las herramientas de calidad y de migraciones. Ninguna
             entra al WAR: son plugins del build. -->
        <version.jacoco>0.8.14</version.jacoco>
        <version.checkstyle>10.26.1</version.checkstyle>
        <version.flyway>11.20.3</version.flyway>
        <version.driver.postgresql>42.7.4</version.driver.postgresql>

        <!-- Base de desarrollo por omision para "mvn flyway:migrate". La
             contrasena NO esta aca: se pasa con -Dflyway.password=... o con la
             variable de entorno FLYWAY_PASSWORD. -->
        <flyway.url>jdbc:postgresql://127.0.0.1:5432/mediconecta</flyway.url>
        <flyway.user>mediconecta</flyway.user>

        <!-- Minimo de lineas cubiertas por los tests unitarios (ver JaCoCo). -->
        <cobertura.minima>0.80</cobertura.minima>
        <!-- Umbrales de los Criterios de Testing para la capa de negocio. -->
        <cobertura.negocio.lineas>0.80</cobertura.negocio.lineas>
        <cobertura.negocio.ramas>0.70</cobertura.negocio.ramas>
        <!-- Mutation score minimo (PIT) sobre la capa de negocio. -->
        <mutacion.minima>60</mutacion.minima>

        <!-- SonarCloud / SonarQube: el projectKey y la organizacion se pasan en
             CI (-Dsonar.projectKey=... -Dsonar.organization=...). -->
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <sonar.coverage.exclusions>**/presentacion/Recurso*.java,**/datos/jpa/**,**/integraciones/simulacion/**,**/webapp/**</sonar.coverage.exclusions>
        <sonar.exclusions>**/webapp/openapi.json</sonar.exclusions>
    </properties>

    <dependencies>
        <!-- Unica dependencia del proyecto: la API completa de Jakarta EE 10.
             Scope "provided" porque las implementaciones (RESTEasy para JAX-RS,
             Weld para CDI, el contenedor de EJB) ya las aporta WildFly.
             Si la empaquetaramos dentro del WAR habria clases duplicadas
             y el despliegue fallaria. -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>10.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- ===== Solo para los tests unitarios (scope test: NO entran al WAR) ===== -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
        <!-- Implementacion de JSON-P para ServicioJwt en los tests. En el
             servidor la aporta WildFly (modulo org.eclipse.parsson). -->
        <dependency>
            <groupId>org.eclipse.parsson</groupId>
            <artifactId>parsson</artifactId>
            <version>1.1.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- El nombre del WAR define el context root en WildFly.
             Resultado: http://localhost:8080/mediconecta/... -->
        <finalName>mediconecta</finalName>

        <!-- Versiones fijas de los plugins que Maven agrega solo (clean,
             resources, install...): sin esto cada version de Maven usaria
             otras y el build no seria reproducible (lo exige el enforcer). -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.3</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.1.3</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>3.21.0</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <!-- ===== Build reproducible: versiones minimas y plugins fijados =====
                 Corta el build si se usa un Maven o un JDK viejos, o si algun
                 plugin quedo sin version fija (cada maquina bajaria otra). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>entorno-reproducible</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                </requireJavaVersion>
                                <requirePluginVersions>
                                    <banSnapshots>true</banSnapshots>
                                </requirePluginVersions>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <!-- Ejecuta los tests de JUnit 5 en "mvn test" y en "mvn package". -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <!-- ===== Linter: Checkstyle =====
                 Corre en la fase "validate", o sea antes de compilar: cualquier
                 "mvn package" o "mvn verify" falla si el codigo no respeta las
                 reglas de config/checkstyle/checkstyle.xml. Se queda en la rama
                 10.x porque la 11 exige Java 21 y el proyecto compila con 17. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${version.checkstyle}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>config/checkstyle/checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>warning</violationSeverity>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>linter</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- ===== Cobertura: JaCoCo =====
                 "mvn test" deja el informe en target/site/jacoco/index.html.
                 "mvn verify" ademas exige el minimo de cobertura de abajo.
                 Las clases que solo tienen sentido dentro del contenedor
                 (recursos REST, repositorios JPA, MDB, sistemas simulados) se
                 excluyen del MINIMO, no del informe: esas las cubre la prueba
                 de punta a punta (scripts/smoke-test.ps1) que corre en CI. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${version.jacoco}</version>
                <executions>
                    <execution>
                        <id>agente</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>informe</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>minimo</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>com/mediconecta/presentacion/Recurso*</exclude>
                                <exclude>com/mediconecta/presentacion/AplicacionRest*</exclude>
                                <exclude>com/mediconecta/presentacion/ConversacionDeReserva*</exclude>
                                <exclude>com/mediconecta/datos/jpa/**</exclude>
                                <exclude>com/mediconecta/integraciones/simulacion/**</exclude>
                                <exclude>com/mediconecta/integraciones/AdaptadorObraSocial*</exclude>
                                <exclude>com/mediconecta/mensajeria/DestinosJms*</exclude>
                                <exclude>com/mediconecta/mensajeria/NotificadorTurnos*</exclude>
                                <exclude>com/mediconecta/negocio/CargaDeDatosDemo*</exclude>
                            </excludes>
                            <rules>
                                <!-- Capa de negocio: 80 % de lineas y 70 % de ramas. -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.mediconecta.negocio</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${cobertura.negocio.lineas}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${cobertura.negocio.ramas}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${cobertura.minima}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ===== Mutation testing: PIT =====
                 mvn test-compile org.pitest:pitest-maven:mutationCoverage
                 Introduce cambios pequenos (mutantes) en la capa de negocio y
                 en el patron State, y corre los tests: un mutante que ningun
                 test detecta es una regla sin verificar de verdad. Falla si el
                 mutation score baja de ${mutacion.minima} %. Informe en
                 target/pit-reports/. Corre en un job propio de CI. -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.30.1</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.2</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>com.mediconecta.negocio.*</param>
                        <param>com.mediconecta.modelo.estado.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.mediconecta.*</param>
                    </targetTests>
                    <excludedClasses>
                        <param>com.mediconecta.negocio.CargaDeDatosDemo</param>
                        <param>com.mediconecta.negocio.LimpiezaIdempotencia</param>
                    </excludedClasses>
                    <mutationThreshold>${mutacion.minima}</mutationThreshold>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <threads>4</threads>
                </configuration>
            </plugin>

            <!-- Analisis de SonarCloud / SonarQube (mvn sonar:sonar). -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>5.8.0.7211</version>
            </plugin>

            <!-- ===== Migraciones: Flyway =====
                 El esquema ya no lo crea Hibernate: lo crean los scripts
                 versionados de db/migraciones (V1__..., V2__...). Hibernate solo
                 lo VALIDA al desplegar (hbm2ddl.auto=validate).

                     mvn flyway:migrate -Dflyway.password=...
                     mvn flyway:info    -Dflyway.password=...

                 El plugin no entra al WAR. En Docker las aplica el servicio
                 "migraciones" de compose.yaml con la imagen oficial de Flyway,
                 sobre los mismos archivos. baselineOnMigrate hace que una base
                 que ya tenia las tablas creadas por Hibernate (Entregas 1 y 2)
                 se tome como version 1 y solo reciba las migraciones nuevas. -->
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <version>${version.flyway}</version>
                <configuration>
                    <locations>
                        <location>filesystem:db/migraciones</location>
                    </locations>
                    <baselineOnMigrate>true</baselineOnMigrate>
                    <baselineVersion>1</baselineVersion>
                    <cleanDisabled>true</cleanDisabled>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-database-postgresql</artifactId>
                        <version>${version.flyway}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${version.driver.postgresql}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <!-- No usamos web.xml: la configuracion de JAX-RS esta
                         en la clase AplicacionRest con @ApplicationPath. -->
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
